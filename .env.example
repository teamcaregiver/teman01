# Copy to .env and fill with your Supabase project values.

# Client-exposed (browser). Only VITE_* vars are bundled to the client.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER ONLY — service-role secret. Do NOT prefix with VITE_. Used only inside server functions.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Where NEW uploads go: "supabase" (default) or "gdrive" (Google Drive via the
# drive-files Edge Function). Not a secret — it only picks a code path. Leave it
# on "supabase" until the Drive setup in docs/GOOGLE-DRIVE-STORAGE.md is verified.
VITE_STORAGE_BACKEND=supabase

# Google Drive secrets are NOT set here. They live only in Supabase Edge
# Function secrets (supabase secrets set ...), never in a VITE_ variable:
#   GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, GOOGLE_OAUTH_REFRESH_TOKEN,
#   GOOGLE_DRIVE_ROOT_FOLDER_ID, DRIVE_URL_SIGNING_SECRET
